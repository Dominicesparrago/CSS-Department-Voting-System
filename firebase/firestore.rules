rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          ("superadmin" in request.auth.token && request.auth.token.superadmin == true)
          || ("role" in request.auth.token && request.auth.token.role == "superadmin")
        );
    }

    // Guard before touching token.email: anonymous (guest) sessions have no email,
    // and referencing a missing token field errors the whole rule evaluation.
    function hasEmailToken() {
      return isSignedIn()
        && "email" in request.auth.token
        && request.auth.token.email is string;
    }

    // Admins granted by the superadmin at runtime, keyed by sign-in email.
    // Checked last so claim-based admins never pay the exists() read.
    function isRegistryAdmin() {
      return hasEmailToken()
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isAdmin() {
      return isSignedIn()
        && (
          ("admin" in request.auth.token && request.auth.token.admin == true)
          || ("superadmin" in request.auth.token && request.auth.token.superadmin == true)
          || ("role" in request.auth.token && request.auth.token.role == "admin")
          || ("role" in request.auth.token && request.auth.token.role == "superadmin")
          || isRegistryAdmin()
        );
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function electionPath(electionId) {
      return /databases/$(database)/documents/elections/$(electionId);
    }

    function voterPath(uid) {
      return /databases/$(database)/documents/voters/$(uid);
    }

    function studentIndexPath(studentNo) {
      return /databases/$(database)/documents/studentIndex/$(studentNo);
    }

    function emailIndexPath(email) {
      return /databases/$(database)/documents/emailIndex/$(email);
    }

    // Results become public once published; finalized and archived elections are
    // historical records that remain readable exactly like published ones.
    function electionPublished(electionId) {
      return get(electionPath(electionId)).data.status in ["published", "finalized", "archived"];
    }

    // Locking/finalization guards. Election data becomes read-only for ordinary
    // admins while the election is locked (active-protection) or finalized
    // (results locked). Superadmin keeps a controlled, audited emergency override.
    function electionLocked(electionId) {
      return electionId is string && get(electionPath(electionId)).data.get("locked", false) == true;
    }

    function electionFinalized(electionId) {
      return electionId is string && get(electionPath(electionId)).data.get("status", "draft") == "finalized";
    }

    // The reference election for voter/position locks (single-active-election model).
    function currentElectionLocked() {
      return electionLocked("css_department_election_2026");
    }

    function currentElectionFinalized() {
      return electionFinalized("css_department_election_2026");
    }

    // Admin writes to shared/global election data (positions, voters) are refused
    // while the current election is locked or finalized, unless superadmin.
    function configWritable() {
      return isAdmin()
        && (isSuperAdmin() || (!currentElectionLocked() && !currentElectionFinalized()));
    }

    // Per-election candidate writes follow the candidate's own election state.
    function candidateWritable(electionId) {
      return isAdmin()
        && (isSuperAdmin() || (!electionLocked(electionId) && !electionFinalized(electionId)));
    }

    function registrationOpen(electionId) {
      return get(electionPath(electionId)).data.get("registrationOpen", true) == true;
    }

    function validStudentEmail(email) {
      return email is string
        && email.matches('^[a-z0-9._-]+[.]scc@gmail[.]com$');
    }

    function validStudentNo(studentNo) {
      return studentNo is string
        && studentNo.matches('^[0-9]{7,9}$');
    }

    function validYearLevel(yearLevel) {
      return yearLevel in [1, 2, 3, 4];
    }

    function validVoterCreate(uid) {
      return isSelf(uid)
        && registrationOpen("css_department_election_2026")
        && request.resource.data.keys().hasOnly([
          "studentNo",
          "fullName",
          "email",
          "yearLevel",
          "section",
          "eligible",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "studentNo",
          "fullName",
          "email",
          "yearLevel",
          "section",
          "eligible",
          "createdAt",
          "updatedAt"
        ])
        && validStudentNo(request.resource.data.studentNo)
        && validStudentEmail(request.resource.data.email)
        && validYearLevel(request.resource.data.yearLevel)
        && request.resource.data.eligible == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !("hasVoted" in request.resource.data)
        && !("votedAt" in request.resource.data);
    }

    function guestSignupAllowed() {
      return exists(/databases/$(database)/documents/config/app)
        && get(/databases/$(database)/documents/config/app).data.get("allowGuestVoters", false) == true;
    }

    function validGuestVoterCreate(uid) {
      return isSelf(uid)
        && registrationOpen("css_department_election_2026")
        && guestSignupAllowed()
        && request.resource.data.keys().hasOnly([
          "studentNo",
          "fullName",
          "email",
          "yearLevel",
          "section",
          "eligible",
          "guest",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "studentNo",
          "fullName",
          "email",
          "yearLevel",
          "section",
          "eligible",
          "guest",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.guest == true
        && validStudentNo(request.resource.data.studentNo)
        && validStudentEmail(request.resource.data.email)
        && validYearLevel(request.resource.data.yearLevel)
        && request.resource.data.eligible == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && getAfter(studentIndexPath(request.resource.data.studentNo)).data.uid == uid
        && getAfter(emailIndexPath(request.resource.data.email)).data.uid == uid
        && !("hasVoted" in request.resource.data)
        && !("votedAt" in request.resource.data);
    }

    function unchangedLockedVoterFields() {
      return (
          (!("studentNo" in resource.data) && !("studentNo" in request.resource.data))
          || request.resource.data.studentNo == resource.data.studentNo
        )
        && request.resource.data.email == resource.data.email
        && request.resource.data.eligible == resource.data.eligible
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validVoterProfileUpdate(uid) {
      return isSelf(uid)
        && unchangedLockedVoterFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName",
          "section",
          "yearLevel",
          "updatedAt"
        ])
        && validYearLevel(request.resource.data.yearLevel)
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.yearLevel == resource.data.yearLevel
          || !("hasVoted" in resource.data)
        );
    }

    function validStudentIndexCreate(studentNo) {
      return isSignedIn()
        && validStudentNo(studentNo)
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.keys().hasAll(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(voterPath(request.auth.uid)).data.studentNo == studentNo;
    }

    function validEmailIndexCreate(email) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly(["uid", "createdAt"])
        && request.resource.data.keys().hasAll(["uid", "createdAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(voterPath(request.auth.uid)).data.email == email
        && getAfter(voterPath(request.auth.uid)).data.guest == true;
    }

    function validAuditCreate() {
      return isSignedIn()
        && request.resource.data.keys().hasAll(["ts", "actorUid", "action", "target"])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.ts == request.time;
    }

    function validAdminGrant(email) {
      return request.resource.data.keys().hasOnly(["email", "role", "addedBy", "reason", "createdAt"])
        && request.resource.data.keys().hasAll(["email", "role", "addedBy", "reason", "createdAt"])
        && request.resource.data.email == email
        && request.resource.data.role == "admin"
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 8
        && request.resource.data.createdAt == request.time;
    }

    function validConfigWrite() {
      return request.resource.data.keys().hasOnly(["allowGuestVoters", "maintenanceMode", "updatedAt", "updatedBy"])
        && request.resource.data.allowGuestVoters is bool
        && request.resource.data.maintenanceMode is bool
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    match /elections/{electionId} {
      allow read: if isSignedIn() || electionPublished(electionId);
      // Creating a new (draft) election is always allowed for admins; editing or
      // deleting an existing election is refused while it is locked or finalized
      // unless superadmin performs a controlled emergency action.
      allow create: if isAdmin();
      allow update, delete: if isAdmin()
        && (isSuperAdmin()
          || (!resource.data.get("locked", false)
            && resource.data.get("status", "draft") != "finalized"));
    }

    match /positions/{positionId} {
      allow read: if true;
      // Positions are shared reference data; guarded by the current election's
      // lock/finalized state so an active election can't be reconfigured.
      allow create, update, delete: if configWritable();
    }

    match /candidates/{candidateId} {
      allow read: if isSignedIn() || electionPublished(resource.data.electionId);
      allow create: if candidateWritable(request.resource.data.electionId);
      allow update, delete: if candidateWritable(resource.data.electionId);
    }

    match /voters/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin() || validVoterCreate(uid) || validGuestVoterCreate(uid);
      // The participation lock (hasVoted/votedAt) is set only by the trusted
      // submitBallot function via the Admin SDK; clients may edit profile fields.
      // Admin edits to voter records (eligibility, registration fixes) are refused
      // while the current election is locked or finalized, unless superadmin.
      allow update: if (isAdmin() && (isSuperAdmin() || (!currentElectionLocked() && !currentElectionFinalized())))
        || validVoterProfileUpdate(uid);
      allow delete: if isAdmin() && (isSuperAdmin() || (!currentElectionLocked() && !currentElectionFinalized()));
    }

    function isOwnRosterStudent(studentNo) {
      return isSignedIn()
        && exists(voterPath(request.auth.uid))
        && get(voterPath(request.auth.uid)).data.studentNo == studentNo;
    }

    // Official student roster, keyed by student number. Written ONLY by the
    // importRoster function via the Admin SDK (which bypasses these rules); no
    // client — voter or admin — may create, update, or delete roster records.
    // Admins can read the whole roster; a student can read only their own
    // record (their own name/section/email/status), so the ballot can give a
    // clear early denial without exposing other students' data.
    match /students/{studentNo} {
      allow read: if isAdmin() || isOwnRosterStudent(studentNo);
      allow create, update, delete: if false;
    }

    match /studentIndex/{studentNo} {
      allow read: if isAdmin();
      allow create: if validStudentIndexCreate(studentNo);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /emailIndex/{email} {
      allow read: if isAdmin();
      allow create: if validEmailIndexCreate(email);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Anonymous ballots. Written only by the trusted submitBallot function
    // (Admin SDK, which bypasses these rules); read server-side by getResults /
    // publishTally. No client — voter or admin — may read or write them, so no
    // request can ever link a ballot to a person. This is the secret ballot.
    match /ballots/{ballotId} {
      allow read, write: if false;
    }

    match /tallies/{electionId} {
      allow read: if isAdmin() || electionPublished(electionId);
      // Written only by the publishTally function via the Admin SDK.
      allow write: if false;
    }

    match /audit/{auditId} {
      allow read: if isAdmin();
      // audit entries come only from admin/superadmin actions; students must not
      // be able to spam or forge the trail
      allow create: if isAdmin() && validAuditCreate();
      allow update, delete: if false;
    }

    // Runtime-managed admin registry, keyed by sign-in email. Superadmin grants
    // and revokes; each admin can read (only) their own entry so the client can
    // resolve access without custom claims.
    match /admins/{email} {
      allow read: if isSuperAdmin() || (hasEmailToken() && request.auth.token.email == email);
      allow create: if isSuperAdmin() && validAdminGrant(email);
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // App-wide policy flags. Publicly readable (the signed-out landing page needs
    // them); writable only by the superadmin with a validated shape.
    match /config/{configId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && validConfigWrite();
      allow delete: if isSuperAdmin();
    }

    // Backup metadata (the JSON payload lives in Storage under backups/). Read
    // by admins so the backup list is visible; written only by the trusted
    // createBackup/restoreBackup functions (Admin SDK) or the superadmin.
    match /backups/{backupId} {
      allow read: if isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
